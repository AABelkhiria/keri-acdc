    "create_exchange_message": "async createExchangeMessage( sender: HabState, route: string, payload: Dict<any>, embeds: Dict<any>, recipient: string, datetime?: string, dig?: string ): Promise<[Serder, string[], string]> { const keeper = this.client.manager!.get(sender); const [exn, end] = exchange( route, payload, sender['prefix'], recipient, datetime, dig, undefined, embeds ); const sigs = await keeper.sign(b(exn.raw)); return [exn, sigs, d(end)]; }",
    "notes": {
      "payloads": "apply carries the schema and its selective-disclosure attributes beside the message; offer, agree, and grant carry the message alone; admit passes `args.message` through with no default, so an admit with no message emits an attribute block carrying no `m` at all",
      "embeds": "only offer and grant embed anything: offer embeds the credential with no attachment, grant embeds the credential, its issuance event, and the anchoring key event, each with the attachment that authenticates the next",
      "signing": "`createExchangeMessage` is `exchange(...)` — keri-protocol's exchange builder — followed by one keeper signature over the serialized message; the attachment stream it returns is the transposed embed material, not the signature"
    }
  },
